# Kimai API Configuration
KIMAI_URL=https://your-kimai-instance.com
KIMAI_API_TOKEN=your-api-token-here

# Optional: Default user ID for operations
# KIMAI_DEFAULT_USER=1

# Optional: SSL verification — true (default), false, or path to a CA bundle
# KIMAI_SSL_VERIFY=true

# Optional: mTLS client certificate, for a Kimai instance behind a reverse
# proxy that requires a client certificate before Kimai's own token auth runs.
# KIMAI_MTLS_CERT_FILE=/path/to/client.crt.pem
# KIMAI_MTLS_KEY_FILE=/path/to/client.key.pem
# KIMAI_MTLS_KEY_PASSWORD=only-if-the-key-is-encrypted
